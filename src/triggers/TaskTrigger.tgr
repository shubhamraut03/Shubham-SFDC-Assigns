trigger TaskTrigger on Task (after insert, after update, after delete, after undelete) {

    if(Trigger.isAfter){
        if(Trigger.isInsert || Trigger.isUpdate || Trigger.isUndelete){
            TaskTriggerHandler.rollupTaskOnAccount(Trigger.new , Trigger.oldMap);
        }
        
        if(Trigger.isDelete){
            TaskTriggerHandler.rollupTaskOnAccount(Trigger.old, Trigger.oldMap);
        }
    }
}